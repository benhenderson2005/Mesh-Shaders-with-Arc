			"dev.thebe.meshshadersarc.MeshShadersWithArcClient"
		],
		"sodium:config_api_user": [
			"dev.thebe.meshshadersarc.config.ArcSodiumConfigEntrypoint"
		],
		"fabric-client-gametest": [
			"dev.thebe.meshshadersarc.test.ArcTerrainClientGameTest"
		]
	},
	"mixins": [
		"mesh-shaders-with-arc.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"sodium": "=0.9.1+mc26.2"
	}
