{
	"schemaVersion": 1,
	"id": "mesh-shaders-with-arc",
	"version": "${version}",
	"name": "Mesh Shaders with Arc",
	"description": "Experimental Sodium-integrated Vulkan mesh-shader terrain renderer for Intel Arc GPUs.",
	"authors": [
		"TheBe"
	],
	"license": "LGPL-3.0-only",
	"icon": "assets/mesh-shaders-with-arc/icon.png",
	"environment": "client",
